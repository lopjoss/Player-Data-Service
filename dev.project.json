{
  "name": "player-data-service",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "PlayerDataService": {
        "$path": "src/playerDataService.luau"
      },
      "Libs": {
        "$className": "Folder",
        "PlayerDataService": {
          "$path": "ServerPackages",
          "Main": {
            "$path": "src/playerDataService"
          }
        }
      }
    },
    "ServerScriptService": {
      "Demo": {
        "$path": "src/demo.server.luau"
      }
    },
